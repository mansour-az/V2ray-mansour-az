+        val item = dataSource.getSubscriptionItem(AppConfig.RASA_SUBSCRIPTION_ID) ?: return
+        val result = dataSource.updateConfigViaSub(
+            SubscriptionCache(AppConfig.RASA_SUBSCRIPTION_ID, item)
+        )
+        if (result.configCount > 0) {
+            setupGroupTab(forceRefresh = true)
+            refreshSelectedGuid()
+        }
+    }
