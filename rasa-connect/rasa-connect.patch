@@ -0,0 +1,46 @@
+package com.v2ray.ang.handler
+
+import com.v2ray.ang.AppConfig
+import com.v2ray.ang.dto.entities.SubscriptionItem
+
+/**
+ * Installs the curated RASA Connect subscription on first launch.
+ *
+ * Existing user choices such as enabled/disabled are preserved. Version 1.0's oversized full
+ * feed is migrated to the tested Top 100 feed so bulk latency tests remain practical on phones.
+ */
+object ManagedSubscriptionBootstrap {
+
+    fun ensureInstalled(): Boolean {
+        val existing = MmkvManager.decodeSubscription(AppConfig.RASA_SUBSCRIPTION_ID)
+        if (existing != null) {
+            val isLegacyFullFeed = existing.url == AppConfig.RASA_LEGACY_SUBSCRIPTION_URL
+            if (shouldReplaceUrl(existing.url)) {
+                existing.url = AppConfig.RASA_SUBSCRIPTION_URL
+                existing.remarks = AppConfig.RASA_SUBSCRIPTION_NAME
+                MmkvManager.encodeSubscription(AppConfig.RASA_SUBSCRIPTION_ID, existing)
+                if (isLegacyFullFeed) {
+                    // Force MainViewModel's immediate bootstrap fetch instead of retaining the
+                    // thousands of profiles imported by version 1.0.
+                    MmkvManager.removeServerViaSubid(AppConfig.RASA_SUBSCRIPTION_ID)
+                }
+            }
+            return false
+        }
+
+        MmkvManager.encodeSubscription(
+            AppConfig.RASA_SUBSCRIPTION_ID,
+            SubscriptionItem(
+                remarks = AppConfig.RASA_SUBSCRIPTION_NAME,
+                url = AppConfig.RASA_SUBSCRIPTION_URL,
+                enabled = true,
+                autoUpdate = true,
+                updateInterval = AppConfig.RASA_SUBSCRIPTION_UPDATE_MINUTES,
+            )
+        )
+        return true
+    }
+
+    internal fun shouldReplaceUrl(url: String): Boolean =
+        url.isBlank() || url == AppConfig.RASA_LEGACY_SUBSCRIPTION_URL
+}
