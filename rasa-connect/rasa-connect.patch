@@ -0,0 +1,40 @@
+package com.v2ray.ang
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import com.v2ray.ang.handler.ManagedSubscriptionBootstrap
+
+class ManagedSubscriptionContractTest {
+
+    @Test
+    fun `managed subscription is HTTPS and points to expected feed`() {
+        assertTrue(AppConfig.RASA_SUBSCRIPTION_URL.startsWith("https://"))
+        assertEquals(
+            "https://cdn.jsdelivr.net/gh/0xRadikal/Free-v2ray-Configs@main/top100.txt",
+            AppConfig.RASA_SUBSCRIPTION_URL,
+        )
+    }
+
+    @Test
+    fun `version 1 full feed is migrated but a custom feed is preserved`() {
+        assertTrue(ManagedSubscriptionBootstrap.shouldReplaceUrl(""))
+        assertTrue(
+            ManagedSubscriptionBootstrap.shouldReplaceUrl(
+                AppConfig.RASA_LEGACY_SUBSCRIPTION_URL
+            )
+        )
+        assertFalse(
+            ManagedSubscriptionBootstrap.shouldReplaceUrl("https://example.com/custom")
+        )
+    }
+
+    @Test
+    fun `automatic refresh respects WorkManager minimum interval`() {
+        assertTrue(
+            AppConfig.RASA_SUBSCRIPTION_UPDATE_MINUTES >=
+                AppConfig.SUBSCRIPTION_MIN_INTERVAL_MINUTES
+        )
+    }
+}
