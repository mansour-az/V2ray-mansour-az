diff --git a/V2rayNG/app/src/main/java/com/v2ray/ang/handler/ManagedSubscriptionBootstrap.kt b/V2rayNG/app/src/main/java/com/v2ray/ang/handler/ManagedSubscriptionBootstrap.kt
