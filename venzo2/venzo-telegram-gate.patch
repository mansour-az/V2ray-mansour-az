@@ -0,0 +1,158 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+
+import '../services/url_launcher.dart';
+import '../services/venzo_telegram_auth.dart';
+
+class VenzoTelegramGate extends StatefulWidget {
+  const VenzoTelegramGate({super.key, required this.child});
+  final Widget child;
+
+  @override
+  State<VenzoTelegramGate> createState() => _VenzoTelegramGateState();
+}
+
+class _VenzoTelegramGateState extends State<VenzoTelegramGate>
+    with WidgetsBindingObserver {
+  final _auth = VenzoTelegramAuth();
+  VenzoTelegramState? _state;
+  bool _busy = true;
+  String? _error;
+
+  @override
+  void initState() {
+    super.initState();
+    WidgetsBinding.instance.addObserver(this);
+    _restore();
+  }
+
+  @override
+  void dispose() {
+    WidgetsBinding.instance.removeObserver(this);
+    super.dispose();
+  }
+
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    if (state == AppLifecycleState.resumed &&
+        !_busy &&
+        _state?.loggedIn == true &&
+        _state?.channelMember != true) {
+      unawaited(_verify());
+    }
+  }
+
+  Future<void> _restore() async {
+    try {
+      final state = await _auth.restore();
+      if (mounted) setState(() => _state = state);
+    } catch (_) {
+      if (mounted) setState(() => _error = 'ارتباط با سرویس ورود برقرار نشد.');
+    } finally {
+      if (mounted) setState(() => _busy = false);
+    }
+  }
+
+  Future<void> _login() async {
+    setState(() { _busy = true; _error = null; });
+    try {
+      final challenge = await _auth.createChallenge();
+      await UrlLauncher.open(challenge.botUrl, fallbackUrl: challenge.botUrl);
+      final deadline = DateTime.now().add(const Duration(minutes: 10));
+      while (mounted && DateTime.now().isBefore(deadline)) {
+        await Future<void>.delayed(const Duration(seconds: 2));
+        var state = await _auth.poll(challenge);
+        if (state != null) {
+          if (!state.channelMember) {
+            try {
+              state = await _auth.verifyMembership();
+            } catch (_) {
+              // The visible retry button remains available on transient errors.
+            }
+          }
+          if (mounted) setState(() => _state = state);
+          return;
+        }
+      }
+      throw const VenzoTelegramException('LOGIN_TIMEOUT');
+    } catch (_) {
+      if (mounted) setState(() => _error = 'ورود کامل نشد؛ دوباره تلاش کنید.');
+    } finally {
+      if (mounted) setState(() => _busy = false);
+    }
+  }
+
+  Future<void> _verify() async {
+    setState(() { _busy = true; _error = null; });
+    try {
+      final state = await _auth.verifyMembership();
+      if (mounted) setState(() => _state = state);
+    } catch (_) {
+      if (mounted) setState(() => _error = 'عضویت تأیید نشد؛ ابتدا کانال را Join کنید.');
+    } finally {
+      if (mounted) setState(() => _busy = false);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (_state?.channelMember == true) return widget.child;
+    final loggedIn = _state?.loggedIn == true;
+    final channelUrl = _state?.channelUrl;
+    return Directionality(
+      textDirection: TextDirection.rtl,
+      child: Scaffold(
+        body: SafeArea(
+          child: Center(
+            child: SingleChildScrollView(
+              padding: const EdgeInsets.all(28),
+              child: ConstrainedBox(
+                constraints: const BoxConstraints(maxWidth: 430),
+                child: Column(
+                  children: [
+                    Image.asset('assets/icons/app_icon.png', width: 92, height: 92),
+                    const SizedBox(height: 22),
+                    Text('ورود به Venzo VPN', style: Theme.of(context).textTheme.headlineSmall?.copyWith(fontWeight: FontWeight.w900)),
+                    const SizedBox(height: 12),
+                    Text(
+                      loggedIn
+                          ? 'ورود تلگرام انجام شد. برای استفاده از سرورهای رایگان باید عضو کانال رسمی Venzo باشید.'
+                          : 'ثبت‌نام با حساب واقعی تلگرام انجام می‌شود؛ رمز یا شماره تلفن شما در اختیار Venzo قرار نمی‌گیرد.',
+                      textAlign: TextAlign.center,
+                    ),
+                    if (_error != null) ...[
+                      const SizedBox(height: 16),
+                      Text(_error!, textAlign: TextAlign.center, style: TextStyle(color: Theme.of(context).colorScheme.error)),
+                    ],
+                    const SizedBox(height: 24),
+                    if (_busy) const CircularProgressIndicator() else if (!loggedIn)
+                      FilledButton.icon(
+                        onPressed: _login,
+                        icon: const Icon(Icons.send_rounded),
+                        label: const Text('ورود امن با تلگرام'),
+                      ) else ...[
+                      FilledButton.icon(
+                        onPressed: channelUrl == null ? null : () => UrlLauncher.open(channelUrl),
+                        icon: const Icon(Icons.campaign_rounded),
+                        label: const Text('عضویت در کانال Venzo'),
+                      ),
+                      const SizedBox(height: 12),
+                      OutlinedButton.icon(
+                        onPressed: _verify,
+                        icon: const Icon(Icons.verified_rounded),
+                        label: const Text('بررسی عضویت و ادامه'),
+                      ),
+                    ],
+                    const SizedBox(height: 18),
+                    const Text('دسترسی رایگان فقط تا زمانی فعال است که عضویت کانال توسط Telegram تأیید شود.', textAlign: TextAlign.center, style: TextStyle(fontSize: 12)),
+                  ],
+                ),
+              ),
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+}
