+import 'package:flutter_test/flutter_test.dart';
+import 'package:lxbox/services/venzo_app_analytics.dart';
+
+void main() {
+  test('anonymous installation id accepts only 16-byte lowercase hex', () {
+    expect(VenzoAppAnalytics.isValidInstallId('0123456789abcdef0123456789abcdef'), isTrue);
+    expect(VenzoAppAnalytics.isValidInstallId('0123456789ABCDEF0123456789ABCDEF'), isFalse);
+    expect(VenzoAppAnalytics.isValidInstallId('0123456789abcdef'), isFalse);
+    expect(VenzoAppAnalytics.isValidInstallId(''), isFalse);
+  });
+}
