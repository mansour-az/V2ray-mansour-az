diff --git a/app/lib/services/venzo_app_analytics.dart b/app/lib/services/venzo_app_analytics.dart
new file mode 100644
index 0000000..cd8233b
--- /dev/null
+++ b/app/lib/services/venzo_app_analytics.dart
@@ -0,0 +1,63 @@
+import 'dart:convert';
+import 'dart:math';
+import 'dart:ui';
+
+import 'package:http/http.dart' as http;
+import 'package:shared_preferences/shared_preferences.dart';
+
+import 'version_info.dart';
+
+/// Records only an anonymous app-open event for operational statistics.
+///
+/// The identifier is random per installation. No phone number, Telegram ID,
+/// IMEI, raw IP address, VPN destination, browsing data or configuration is
+/// included in the request.
+class VenzoAppAnalytics {
+  VenzoAppAnalytics._();
+
+  static const _apiBase = String.fromEnvironment(
+    'VENZO_API_BASE',
+    defaultValue: 'https://venzo-store-api.mascot-gt.workers.dev',
+  );
+  static const _installIdKey = 'venzo_anonymous_install_id_v1';
+
+  static Future<void> recordOpen({http.Client? client}) async {
+    try {
+      final prefs = await SharedPreferences.getInstance();
+      var installId = prefs.getString(_installIdKey) ?? '';
+      if (!isValidInstallId(installId)) {
+        installId = _randomHex(16);
+        await prefs.setString(_installIdKey, installId);
+      }
+      final response = await (client ?? http.Client())
+          .post(
+            Uri.parse(_apiBase).resolve('/v1/telemetry/app-open'),
+            headers: const {
+              'Accept': 'application/json',
+              'Content-Type': 'application/json',
+            },
+            body: jsonEncode({
+              'install_id': installId,
+              'platform': 'android',
+              'app_version': VersionInfo.I.version,
+              'build_number': VersionInfo.I.buildNumber,
+              'locale': PlatformDispatcher.instance.locale.toLanguageTag(),
+            }),
+          )
+          .timeout(const Duration(seconds: 8));
+      if (response.statusCode < 200 || response.statusCode >= 300) return;
+    } catch (_) {
+      // Analytics must never delay startup or affect VPN availability.
+    }
+  }
+
+  static bool isValidInstallId(String value) =>
+      RegExp(r'^[a-f0-9]{32}$').hasMatch(value);
+
+  static String _randomHex(int bytes) {
+    final random = Random.secure();
+    return List<int>.generate(bytes, (_) => random.nextInt(256))
+        .map((value) => value.toRadixString(16).padLeft(2, '0'))
+        .join();
+  }
+}
