+import 'package:flutter_test/flutter_test.dart';
+import 'package:lxbox/services/venzo_telegram_auth.dart';
+
+void main() {
+  test('only the Venzo Worker free catalog receives Telegram credentials', () {
+    expect(
+      VenzoTelegramAuth.isFreeCatalog(Uri.parse(
+          'https://venzo-store-api.mascot-gt.workers.dev/v1/free/subscription')),
+      isTrue,
+    );
+    expect(
+      VenzoTelegramAuth.isFreeCatalog(Uri.parse(
+          'https://raw.githubusercontent.com/example/free/main/sub.txt')),
+      isFalse,
+    );
+    expect(
+      VenzoTelegramAuth.isFreeCatalog(Uri.parse(
+          'https://venzo-store-api.mascot-gt.workers.dev/v1/plans')),
+      isFalse,
+    );
+  });
+}
