+++ b/app/lib/services/venzo_telegram_auth.dart
@@ -0,0 +1,188 @@
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:flutter_secure_storage/flutter_secure_storage.dart';
+import 'package:http/http.dart' as http;
+
+class VenzoTelegramAuth {
+  VenzoTelegramAuth({http.Client? client}) : _client = client ?? http.Client();
+
+  static const _apiBase = String.fromEnvironment(
+    'VENZO_API_BASE',
+    defaultValue: 'https://venzo-store-api.mascot-gt.workers.dev',
+  );
+  static const _tokenKey = 'venzo_telegram_access_token_v1';
+  static const _storage = FlutterSecureStorage(
+    aOptions: AndroidOptions(encryptedSharedPreferences: true),
+  );
+  static String? _memoryToken;
+  final http.Client _client;
+
+  static Future<String?> accessToken() async {
+    final cached = _memoryToken;
+    if (cached != null && cached.isNotEmpty) return cached;
+    final stored = await _storage.read(key: _tokenKey);
+    _memoryToken = stored;
+    return stored;
+  }
+
+  static bool isFreeCatalog(Uri uri) {
+    final base = Uri.tryParse(_apiBase);
+    return base != null &&
+        uri.scheme == base.scheme &&
+        uri.host == base.host &&
+        uri.path == '/v1/free/subscription';
+  }
+
+  static Future<Map<String, String>> subscriptionHeaders(Uri uri) async {
+    if (!isFreeCatalog(uri)) return const {};
+    final value = await accessToken();
+    return value == null || value.isEmpty
+        ? const {}
+        : {'Authorization': 'Bearer $value'};
+  }
+
+  Future<VenzoTelegramState> restore() async {
+    final value = await accessToken();
+    if (value == null || value.isEmpty) return const VenzoTelegramState.loggedOut();
+    final response = await _client.get(
+      _uri('/v1/auth/me'),
+      headers: {'Accept': 'application/json', 'Authorization': 'Bearer $value'},
+    ).timeout(const Duration(seconds: 15));
+    if (response.statusCode == 401) {
+      await logout();
+      return const VenzoTelegramState.loggedOut();
+    }
+    if (response.statusCode != 200) throw VenzoTelegramException('AUTH_${response.statusCode}');
+    return _stateFrom(response);
+  }
+
+  Future<VenzoLoginChallenge> createChallenge() async {
+    final response = await _client.post(
+      _uri('/v1/auth/telegram/sessions'),
+      headers: const {'Accept': 'application/json'},
+    ).timeout(const Duration(seconds: 15));
+    if (response.statusCode != 201) throw VenzoTelegramException('LOGIN_${response.statusCode}');
+    final json = _json(response);
+    return VenzoLoginChallenge(
+      token: json['login_token']?.toString() ?? '',
+      pollSecret: json['poll_secret']?.toString() ?? '',
+      botUrl: json['bot_url']?.toString() ?? '',
+    );
+  }
+
+  Future<VenzoTelegramState?> poll(VenzoLoginChallenge challenge) async {
+    final response = await _client.get(
+      _uri('/v1/auth/telegram/sessions/${challenge.token}'),
+      headers: {
+        'Accept': 'application/json',
+        'X-Venzo-Login-Secret': challenge.pollSecret,
+      },
+    ).timeout(const Duration(seconds: 15));
+    if (response.statusCode == 202) return null;
+    if (response.statusCode != 200) throw VenzoTelegramException('POLL_${response.statusCode}');
+    final json = _json(response);
+    final value = json['access_token']?.toString() ?? '';
+    if (value.isEmpty) throw const VenzoTelegramException('INVALID_ACCESS_TOKEN');
+    await _storage.write(key: _tokenKey, value: value);
+    _memoryToken = value;
+    return VenzoTelegramState(
+      loggedIn: true,
+      channelMember: json['channel_member'] == true,
+      user: VenzoTelegramUser.fromJson(json['user']),
+      channelUrl: json['channel_url']?.toString(),
+    );
+  }
+
+  Future<VenzoTelegramState> verifyMembership() async {
+    final value = await accessToken();
+    if (value == null) return const VenzoTelegramState.loggedOut();
+    final response = await _client.post(
+      _uri('/v1/auth/telegram/membership'),
+      headers: {'Accept': 'application/json', 'Authorization': 'Bearer $value'},
+    ).timeout(const Duration(seconds: 15));
+    if (response.statusCode == 401) {
+      await logout();
+      return const VenzoTelegramState.loggedOut();
+    }
+    if (response.statusCode != 200) throw VenzoTelegramException('MEMBERSHIP_${response.statusCode}');
+    final state = _stateFrom(response);
+    final config = await _client.get(_uri('/v1/auth/telegram/config'));
+    if (config.statusCode != 200) return state;
+    final configJson = _json(config);
+    return state.copyWith(channelUrl: configJson['channel_url']?.toString());
+  }
+
+  Future<void> logout() async {
+    _memoryToken = null;
+    await _storage.delete(key: _tokenKey);
+  }
+
+  VenzoTelegramState _stateFrom(http.Response response) {
+    final json = _json(response);
+    return VenzoTelegramState(
+      loggedIn: true,
+      channelMember: json['channel_member'] == true,
+      user: VenzoTelegramUser.fromJson(json['user']),
+      channelUrl: json['channel_url']?.toString(),
+    );
+  }
+
+  Uri _uri(String path) => Uri.parse(_apiBase).resolve(path);
+
+  Map<String, dynamic> _json(http.Response response) =>
+      (jsonDecode(utf8.decode(response.bodyBytes)) as Map).cast<String, dynamic>();
+}
+
+class VenzoLoginChallenge {
+  const VenzoLoginChallenge({required this.token, required this.pollSecret, required this.botUrl});
+  final String token;
+  final String pollSecret;
+  final String botUrl;
+}
+
+class VenzoTelegramState {
+  const VenzoTelegramState({
+    required this.loggedIn,
+    required this.channelMember,
+    this.user,
+    this.channelUrl,
+  });
+  const VenzoTelegramState.loggedOut()
+      : loggedIn = false,
+        channelMember = false,
+        user = null,
+        channelUrl = null;
+  final bool loggedIn;
+  final bool channelMember;
+  final VenzoTelegramUser? user;
+  final String? channelUrl;
+
+  VenzoTelegramState copyWith({String? channelUrl}) => VenzoTelegramState(
+        loggedIn: loggedIn,
+        channelMember: channelMember,
+        user: user,
+        channelUrl: channelUrl ?? this.channelUrl,
+      );
+}
+
+class VenzoTelegramUser {
+  const VenzoTelegramUser({required this.id, this.username, this.firstName});
+  final String id;
+  final String? username;
+  final String? firstName;
+
+  factory VenzoTelegramUser.fromJson(dynamic value) {
+    final json = value is Map ? value : const {};
+    return VenzoTelegramUser(
+      id: json['telegram_id']?.toString() ?? '',
+      username: json['username']?.toString(),
+      firstName: json['first_name']?.toString(),
+    );
+  }
+}
+
+class VenzoTelegramException implements Exception {
+  const VenzoTelegramException(this.code);
+  final String code;
+}
