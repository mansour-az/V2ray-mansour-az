diff --git a/app/test/controllers/venzo_smart_connect_test.dart b/app/test/controllers/venzo_smart_connect_test.dart
index 01284ec..cf1f3c4 100644
--- a/app/test/controllers/venzo_smart_connect_test.dart
+++ b/app/test/controllers/venzo_smart_connect_test.dart
@@ -104,4 +104,45 @@ void main() {
     final items = List.generate(200, (i) => outbound('node-$i'));
     expect(venzoSmartProbeOrder(items: items), hasLength(24));
   });
+
+  test('fallback ladder keeps normal nodes before MASQUE and WARP', () {
+    final items = <CcOutbound>[
+      outbound('WARP-fast', type: 'wireguard', delay: 10, testedAt: 1),
+      outbound('masque-fast', type: 'masque', delay: 20, testedAt: 1),
+      outbound('vless-slow', type: 'vless', delay: 300, testedAt: 1),
+      outbound('wireguard-generic', type: 'wireguard', delay: 5, testedAt: 1),
+    ];
+
+    expect(
+      venzoSmartProbeOrder(items: items),
+      ['vless-slow', 'masque-fast', 'WARP-fast', 'wireguard-generic'],
+    );
+  });
+
+  test('fallback transports are collected from nested selector groups', () {
+    final selector = group(
+      tag: 'vpn-1',
+      type: 'Selector',
+      selectable: true,
+      items: [outbound('free-auto'), outbound('emergency')],
+    );
+    final emergency = group(
+      tag: 'emergency',
+      type: 'Selector',
+      selectable: false,
+      items: [
+        outbound('ordinary', type: 'vless'),
+        outbound('WARP', type: 'wireguard'),
+        outbound('MASQUE-H3', type: 'masque'),
+      ],
+    );
+
+    expect(
+      venzoSelectorFallbackTransports(
+        selector: selector,
+        groups: [emergency],
+      ).map((item) => item.tag),
+      ['WARP', 'MASQUE-H3'],
+    );
+  });
 }
