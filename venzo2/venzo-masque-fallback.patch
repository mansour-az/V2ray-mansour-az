+/// Connection ladder used by Venzo. Normal subscription nodes are preferred;
+/// MASQUE and WARP are escape transports and are only promoted after the
+/// ordinary route candidates fail real-traffic verification.
+int venzoFallbackPriority({required String tag, required String type}) {
+  final normalizedTag = tag.toLowerCase();
+  final normalizedType = type.toLowerCase();
+  if (normalizedType == 'masque' || normalizedTag.contains('masque')) return 1;
+  if (normalizedType == 'wireguard' && normalizedTag.contains('warp')) return 2;
+  if (normalizedType == 'wireguard') return 3;
+  return 0;
+}
+
+String venzoFallbackStageLabel({required String tag, required String type}) {
+  return switch (venzoFallbackPriority(tag: tag, type: type)) {
+    1 => 'مسیر جایگزین MASQUE / HTTP3',
+    2 => 'مسیر جایگزین Cloudflare WARP',
+    3 => 'مسیر جایگزین WireGuard',
+    _ => 'سرورهای معمول Venzo',
+  };
+}
+
+/// Finds MASQUE/WARP/WireGuard payloads reachable through the active selector,
+/// including nodes nested in subscription groups. The returned outbounds can
+/// be appended to the channel AUTO group without exposing unrelated channels.
+List<CcOutbound> venzoSelectorFallbackTransports({
+  required CcGroup selector,
+  required Iterable<CcGroup> groups,
+}) {
+  return venzoSelectorPayloads(selector: selector, groups: groups)
+      .where((payload) =>
+          venzoFallbackPriority(tag: payload.tag, type: payload.type) > 0)
+      .toList(growable: false);
+}
+
+List<CcOutbound> venzoSelectorPayloads({
+  required CcGroup selector,
+  required Iterable<CcGroup> groups,
+}) {
+  final byTag = {for (final group in groups) group.tag: group};
+  final result = <String, CcOutbound>{};
+  for (final item in selector.items) {
+    final nested = byTag[item.tag];
+    final payloads = nested?.items ?? <CcOutbound>[item];
+    for (final payload in payloads) {
+      result.putIfAbsent(payload.tag, () => payload);
+    }
+  }
+  return result.values.toList(growable: false);
+}
+
