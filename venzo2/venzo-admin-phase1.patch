diff --git a/app/lib/services/venzo_connection_policy.dart b/app/lib/services/venzo_connection_policy.dart
new file mode 100644
index 0000000..ef98cf0
--- /dev/null
+++ b/app/lib/services/venzo_connection_policy.dart
@@ -0,0 +1,54 @@
+import 'dart:convert';
+
+import 'package:http/http.dart' as http;
+import 'package:shared_preferences/shared_preferences.dart';
+
+/// Remote settings cannot inject endpoints, credentials or tunnel parameters.
+class VenzoConnectionPolicy {
+  const VenzoConnectionPolicy({this.enabled = true, this.order = transports});
+  static const transports = ['normal', 'masque', 'warp', 'wireguard'];
+  final bool enabled;
+  final List<String> order;
+  static const _cacheKey = 'venzo_connection_policy_v1';
+  static const _apiBase = String.fromEnvironment('VENZO_API_BASE',
+      defaultValue: 'https://venzo-store-api.mascot-gt.workers.dev');
+
+  static VenzoConnectionPolicy? parse(Object? value) {
+    if (value is! Map || value['version'] != 1 || value['enabled'] is! bool) {
+      return null;
+    }
+    final raw = value['order'];
+    if (raw is! List || raw.length != 4 || raw.first != 'normal' ||
+        raw.toSet().length != 4 || raw.any((x) => !transports.contains(x))) {
+      return null;
+    }
+    return VenzoConnectionPolicy(enabled: value['enabled'] as bool,
+        order: List<String>.unmodifiable(raw.cast<String>()));
+  }
+
+  static Future<VenzoConnectionPolicy> load({http.Client? client}) async {
+    var policy = const VenzoConnectionPolicy();
+    http.Client? owned;
+    try {
+      final prefs = await SharedPreferences.getInstance();
+      final cached = prefs.getString(_cacheKey);
+      if (cached != null) {
+        try { policy = parse(jsonDecode(cached)) ?? policy; } catch (_) { /* ignore corrupt cache */ }
+      }
+      final sender = client ?? (owned = http.Client());
+      final response = await sender.get(Uri.parse(_apiBase)
+          .resolve('/v1/connection-policy')).timeout(const Duration(seconds: 2));
+      if (response.statusCode == 200 && response.bodyBytes.length <= 2048) {
+        final next = parse(jsonDecode(response.body));
+        if (next != null) {
+          policy = next;
+          await prefs.setString(_cacheKey, jsonEncode({
+            'version': 1, 'enabled': next.enabled, 'order': next.order,
+          }));
+        }
+      }
+    } catch (_) { /* Cached/default policy keeps connection available offline. */ }
+    finally { owned?.close(); }
+    return policy;
+  }
+}
