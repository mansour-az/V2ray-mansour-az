+  test('large regular list cannot starve alternative transports', () {
+    CcOutbound node(String tag, String type) => CcOutbound(tag: tag, type: type, urlTestDelay: 0, urlTestTime: 0);
+    final items = [
+      ...List.generate(100, (i) => node('normal-$i','vless')),
+      node('masque','masque'),node('WARP','wireguard'),node('wg','wireguard'),
+    ];
+    final order = venzoSmartProbeOrder(items:items,transportOrder:['normal','warp','wireguard','masque']);
+    expect(order,hasLength(24));
+    expect(order.take(21).every((x)=>x.startsWith('normal-')),isTrue);
+    expect(order.skip(21).toList(),['WARP','wg','masque']);
+    expect(venzoSmartProbeOrder(items:items,fallbackEnabled:false).every((x)=>x.startsWith('normal-')),isTrue);
+  });
