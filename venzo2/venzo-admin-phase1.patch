+    final client = MockClient((_) async { calls++; return http.Response('{}', 202); });
+    await VenzoAppAnalytics.recordOpen(client: client);
+    await VenzoAppAnalytics.recordConnection(outcome: 'success', transport: 'masque', durationMs: 1, error: 'none', client: client);
+    expect(calls, 0);
+    expect((await SharedPreferences.getInstance()).getKeys(), isEmpty);
+  });
+
+  test('opt-in sends only allowlisted fields; withdrawal prevents future sends', () async {
+    final bodies = <Map<String, dynamic>>[];
+    final client = MockClient((request) async {
+      bodies.add(jsonDecode(request.body) as Map<String, dynamic>);
+      return http.Response('{}', 202);
+    });
+    await VenzoAppAnalytics.setEnabled(true);
+    await VenzoAppAnalytics.recordConnection(outcome: 'success', transport: 'warp', durationMs: 700000, error: 'none', client: client);
+    expect(bodies.single.keys.toSet(), {'consent','install_id','app_version','event_id','outcome','transport','duration_ms','error'});
+    expect(bodies.single['duration_ms'], 600000);
+    await VenzoAppAnalytics.setEnabled(false);
+    await VenzoAppAnalytics.recordOpen(client: client);
+    expect(bodies, hasLength(1));
+    expect((await SharedPreferences.getInstance()).getString('venzo_anonymous_install_id_v1'), isNull);
+  });
+
+  test('policy validates exact permutation, caches and tolerates offline API', () async {
+    final policy = {'version':1,'enabled':false,'order':['normal','warp','masque','wireguard']};
+    expect(VenzoConnectionPolicy.parse({...policy,'order':['warp','normal','masque','wireguard']}), isNull);
+    expect(VenzoConnectionPolicy.parse({...policy,'order':['normal','warp','warp','wireguard']}), isNull);
+    final loaded = await VenzoConnectionPolicy.load(client: MockClient((_) async => http.Response(jsonEncode(policy),200)));
+    expect(loaded.enabled, isFalse);
+    final cached = await VenzoConnectionPolicy.load(client: MockClient((_) async => throw Exception('offline')));
+    expect(cached.order, loaded.order);
+    expect(cached.enabled, isFalse);
+  });
