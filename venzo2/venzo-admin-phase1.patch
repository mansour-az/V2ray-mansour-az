+  test('selector traversal handles deep nesting and cycles', () {
+    CcOutbound node(String tag,String type) => CcOutbound(tag:tag,type:type,urlTestDelay:0,urlTestTime:0);
+    CcGroup group(String tag,List<CcOutbound> items) => CcGroup(tag:tag,type:'Selector',selectable:true,selected:'',isExpand:false,items:items);
+    final root=group('root',[node('a','Selector')]);
+    final a=group('a',[node('b','Selector')]);
+    final b=group('b',[node('root','Selector'),node('masque','masque')]);
