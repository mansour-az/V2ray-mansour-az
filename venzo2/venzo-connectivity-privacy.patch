+                          .textTheme
+                          .titleMedium
+                          ?.copyWith(fontWeight: FontWeight.w800),
+                    ),
+                    const SizedBox(height: 4),
+                    Text(verified
+                        ? 'IP عمومی و عبور واقعی اینترنت بررسی شده است.'
