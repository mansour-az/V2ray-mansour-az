+    return Scaffold(
+      appBar: AppBar(title: const Text('حریم خصوصی')),
+      body: AnimatedBuilder(
+        animation: controller,
+        builder: (context, _) {
+          final verified = controller.venzoConnectionVerified;
+          final dnsConfigured = _hasProtectedDns(
