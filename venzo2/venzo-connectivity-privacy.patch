+import 'package:flutter_test/flutter_test.dart';
+import 'package:lxbox/services/venzo_connection_verifier.dart';
+
+void main() {
+  test('parses Cloudflare trace public IP', () {
+    const body = 'fl=1\nh=1.1.1.1\nip=203.0.113.7\nwarp=off\n';
+    expect(
+      VenzoConnectionVerifier.parsePublicIp(body),
+      '203.0.113.7',
+    );
+  });
+
+  test('parses a plain public IP response', () {
+    expect(
+      VenzoConnectionVerifier.parsePublicIp('2001:db8::7\n'),
+      '2001:db8::7',
+    );
+  });
+
+  test('rejects missing or invalid public IP', () {
+    expect(VenzoConnectionVerifier.parsePublicIp('warp=off\n'), isNull);
+    expect(VenzoConnectionVerifier.parsePublicIp('not-an-ip'), isNull);
+  });
+
+  test('requires a changed system route after outbound HTTP succeeds', () {
+    expect(
+      VenzoConnectionVerifier.routeIsVerified(
+        baselineIp: '198.51.100.2',
+        outboundIp: '203.0.113.7',
+        systemIp: '203.0.113.7',
+      ),
+      isTrue,
+    );
+    expect(
+      VenzoConnectionVerifier.routeIsVerified(
+        baselineIp: '198.51.100.2',
+        outboundIp: '2001:db8::7',
+        systemIp: '203.0.113.7',
+      ),
+      isTrue,
+    );
+    expect(
+      VenzoConnectionVerifier.routeIsVerified(
+        baselineIp: '198.51.100.2',
+        outboundIp: '203.0.113.7',
+        systemIp: '198.51.100.2',
+      ),
+      isFalse,
+    );
+    expect(
+      VenzoConnectionVerifier.routeIsVerified(
+        baselineIp: null,
+        outboundIp: '203.0.113.7',
+        systemIp: '203.0.113.8',
+      ),
+      isFalse,
+    );
+    expect(
+      VenzoConnectionVerifier.routeIsVerified(
+        baselineIp: null,
+        outboundIp: null,
+        systemIp: '203.0.113.8',
+      ),
+      isTrue,
+    );
+    expect(
+      VenzoConnectionVerifier.routeIsVerified(
+        baselineIp: '198.51.100.2',
+        outboundIp: null,
+        systemIp: null,
+      ),
+      isFalse,
+    );
+    expect(
+      VenzoConnectionVerifier.routeIsVerified(
+        baselineIp: '203.0.113.7',
+        outboundIp: '203.0.113.7',
+        systemIp: '203.0.113.7',
+      ),
+      isFalse,
+    );
+  });
+}
