@@ -0,0 +1,74 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+/// End-to-end verification used by Venzo Smart Connect.
+///
+/// A URLTest delay only proves that sing-box could open one test URL through
+/// an outbound. Venzo also checks the public IP seen by normal app traffic
+/// after selecting that outbound, so a live core or a Ping value can never be
+/// presented as a verified VPN connection on its own.
+class VenzoConnectionVerifier {
+  VenzoConnectionVerifier._();
+
+  static const traceUrl = 'https://1.1.1.1/cdn-cgi/trace';
+  static const probeUrls = <String>[
+    'https://www.gstatic.com/generate_204',
+    'https://connectivitycheck.gstatic.com/generate_204',
+    'https://cp.cloudflare.com/generate_204',
+    traceUrl,
+    'http://www.gstatic.com/generate_204',
+  ];
+  static const _fallbackUrls = <String>[
+    'https://api.ipify.org',
+    'https://checkip.amazonaws.com',
+    'https://ipv4.icanhazip.com',
+    traceUrl,
+    'https://cloudflare.com/cdn-cgi/trace',
+  ];
+
+  static Future<String?> fetchPublicIp({
+    Duration timeout = const Duration(seconds: 7),
+  }) async {
+    for (final endpoint in _fallbackUrls) {
+      final client = HttpClient()
+        ..connectionTimeout = timeout
+        ..idleTimeout = const Duration(seconds: 1);
+      try {
+        final request = await client
+            .getUrl(Uri.parse(endpoint))
+            .timeout(timeout);
+        request.headers.set(
+          HttpHeaders.userAgentHeader,
+          'VenzoVPN/2.6.0 connectivity-check',
+        );
+        request.persistentConnection = false;
+        final response = await request.close().timeout(timeout);
+        if (response.statusCode < 200 || response.statusCode >= 300) continue;
+        final body = await utf8
+            .decoder
+            .bind(response)
+            .join()
+            .timeout(timeout);
+        final ip = parsePublicIp(body);
+        if (ip != null) return ip;
+      } catch (_) {
+        // Try the next independent endpoint.
+      } finally {
+        client.close(force: true);
+      }
+    }
+    return null;
+  }
+
+  static String? parsePublicIp(String body) {
+    for (final line in const LineSplitter().convert(body.trim())) {
+      final value = line.startsWith('ip=')
+          ? line.substring(3).trim()
+          : line.trim();
+      if (InternetAddress.tryParse(value) != null) return value;
+    }
+    return null;
+  }
+
+  static bool routeIsVerified({
+    required String? baselineIp,
+    required String? outboundIp,
+    required String? systemIp,
+  }) {
+    if (systemIp == null) return false;
+    if (baselineIp != null) return baselineIp != systemIp;
+    // The caller has already completed a real HTTP exchange through the
+    // selected outbound. If an exit-IP endpoint was available, compare it;
+    // otherwise the post-connect public IP is sufficient as the fallback.
+    return outboundIp == null || outboundIp == systemIp;
+  }
+}
