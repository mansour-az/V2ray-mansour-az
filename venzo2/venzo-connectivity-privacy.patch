+            : Theme.of(context).colorScheme.errorContainer,
+        child: Padding(
+          padding: const EdgeInsets.all(18),
+          child: Row(
+            children: [
+              Icon(
+                verified
+                    ? Icons.verified_user_rounded
+                    : Icons.shield_outlined,
+                size: 42,
+                color: verified
+                    ? Colors.green
