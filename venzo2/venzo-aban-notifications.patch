diff --git a/app/android/app/src/main/kotlin/com/leadaxe/lxbox/VenzoAnnouncementWorker.kt b/app/android/app/src/main/kotlin/com/leadaxe/lxbox/VenzoAnnouncementWorker.kt
new file mode 100644
index 0000000..85cfe24
--- /dev/null
+++ b/app/android/app/src/main/kotlin/com/leadaxe/lxbox/VenzoAnnouncementWorker.kt
@@ -0,0 +1,144 @@
+package com.leadaxe.lxbox
+
+import android.Manifest
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.net.Uri
+import android.os.Build
+import androidx.core.app.NotificationCompat
+import androidx.core.app.NotificationManagerCompat
+import androidx.core.content.ContextCompat
+import androidx.work.Constraints
+import androidx.work.CoroutineWorker
+import androidx.work.ExistingPeriodicWorkPolicy
+import androidx.work.NetworkType
+import androidx.work.PeriodicWorkRequestBuilder
+import androidx.work.WorkManager
+import androidx.work.WorkerParameters
+import org.json.JSONObject
+import java.net.HttpURLConnection
+import java.net.URL
+import java.util.concurrent.TimeUnit
+
+class VenzoAnnouncementWorker(
+    appContext: Context,
+    params: WorkerParameters,
+) : CoroutineWorker(appContext, params) {
+
+    override suspend fun doWork(): Result {
+        if (
+            Build.VERSION.SDK_INT >= 33 &&
+            ContextCompat.checkSelfPermission(
+                applicationContext,
+                Manifest.permission.POST_NOTIFICATIONS,
+            ) != PackageManager.PERMISSION_GRANTED
+        ) return Result.success()
+
+        return try {
+            val connection = URL(API_URL).openConnection() as HttpURLConnection
+            connection.connectTimeout = 10_000
+            connection.readTimeout = 10_000
+            connection.requestMethod = "GET"
+            connection.setRequestProperty("Accept", "application/json")
+            connection.setRequestProperty("User-Agent", "Venzo-VPN-Android/2.7")
+            val status = connection.responseCode
+            if (status != 200) {
+                connection.disconnect()
+                return if (status >= 500 || status == 429) Result.retry() else Result.success()
+            }
+            val body = connection.inputStream.bufferedReader().use { it.readText() }
+            connection.disconnect()
+            deliver(JSONObject(body))
+            Result.success()
+        } catch (_: Exception) {
+            Result.retry()
+        }
+    }
+
+    private fun deliver(payload: JSONObject) {
+        createChannel()
+        val prefs = applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        val seen = prefs.getStringSet(KEY_SEEN, emptySet())?.toMutableSet() ?: mutableSetOf()
+        val rows = payload.optJSONArray("announcements") ?: return
+        var changed = false
+        for (index in 0 until rows.length()) {
+            val item = rows.optJSONObject(index) ?: continue
+            val id = item.optString("id").trim()
+            val title = item.optString("title").trim()
+            val body = item.optString("body").trim()
+            if (id.isEmpty() || title.isEmpty() || body.isEmpty() || id in seen) continue
+            showNotification(id, title, body, item.optString("action_url"))
+            seen += id
+            changed = true
+        }
+        if (changed) {
+            prefs.edit().putStringSet(KEY_SEEN, seen.toList().takeLast(100).toSet()).apply()
+        }
+    }
+
+    private fun createChannel() {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O) return
+        val manager = applicationContext.getSystemService(NotificationManager::class.java)
+        manager.createNotificationChannel(
+            NotificationChannel(
+                CHANNEL_ID,
+                "آپدیت‌ها و پیشنهادهای Venzo",
+                NotificationManager.IMPORTANCE_DEFAULT,
+            ).apply {
+                description = "اعلان نسخه جدید، تخفیف و خبرهای مهم Venzo VPN"
+            },
+        )
+    }
+
+    private fun showNotification(id: String, title: String, body: String, actionUrl: String) {
+        val intent = if (actionUrl.startsWith("https://")) {
+            Intent(Intent.ACTION_VIEW, Uri.parse(actionUrl))
+        } else {
+            applicationContext.packageManager.getLaunchIntentForPackage(applicationContext.packageName)
+                ?: Intent(applicationContext, MainActivity::class.java)
+        }.apply { flags = Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TOP }
+        val pendingIntent = PendingIntent.getActivity(
+            applicationContext,
+            id.hashCode(),
+            intent,
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
+        )
+        val notification = NotificationCompat.Builder(applicationContext, CHANNEL_ID)
+            .setSmallIcon(com.leadaxe.lxbox.R.drawable.ic_lxbox_tile)
+            .setContentTitle(title)
+            .setContentText(body)
+            .setStyle(NotificationCompat.BigTextStyle().bigText(body))
+            .setContentIntent(pendingIntent)
+            .setAutoCancel(true)
+            .setPriority(NotificationCompat.PRIORITY_DEFAULT)
+            .build()
+        NotificationManagerCompat.from(applicationContext).notify(id.hashCode(), notification)
+    }
+
+    companion object {
+        private const val API_URL = "https://venzo-store-api.mascot-gt.workers.dev/v1/announcements"
+        private const val CHANNEL_ID = "venzo_updates_offers"
+        private const val PREFS = "venzo_announcements"
+        private const val KEY_SEEN = "seen_ids"
+        private const val UNIQUE_WORK = "venzo_periodic_announcements"
+
+        fun schedule(context: Context) {
+            val constraints = Constraints.Builder()
+                .setRequiredNetworkType(NetworkType.CONNECTED)
+                .build()
+            val request = PeriodicWorkRequestBuilder<VenzoAnnouncementWorker>(6, TimeUnit.HOURS)
+                .setInitialDelay(2, TimeUnit.MINUTES)
+                .setConstraints(constraints)
+                .build()
+            WorkManager.getInstance(context).enqueueUniquePeriodicWork(
+                UNIQUE_WORK,
+                ExistingPeriodicWorkPolicy.UPDATE,
+                request,
+            )
+        }
+    }
+}
