diff --git a/work/upstream/app/test/services/venzo_payment_gateways_test.dart b/app/test/services/venzo_payment_gateways_test.dart
new file mode 100644
index 0000000..d7e7998
--- /dev/null
+++ b/app/test/services/venzo_payment_gateways_test.dart
@@ -0,0 +1,26 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:lxbox/services/venzo_store_api.dart';
+
+void main() {
+  test('hosted payment methods map to API values', () {
+    expect(VenzoPaymentMethod.swapPay.apiValue, 'swappay');
+    expect(VenzoPaymentMethod.oxaPay.apiValue, 'oxapay');
+    expect(VenzoPaymentMethodApi.fromApi('swappay'),
+        VenzoPaymentMethod.swapPay);
+    expect(
+        VenzoPaymentMethodApi.fromApi('oxapay'), VenzoPaymentMethod.oxaPay);
+  });
+
+  test('provider failure status is represented as a failed order', () {
+    final order = VenzoOrder.fromJson({
+      'id': 'test-order',
+      'status': 'payment_failed',
+      'payment_method': 'oxapay',
+      'payment': {'track_id': '123'},
+      'price_irr': 8500000,
+    });
+
+    expect(order.isFailed, isTrue);
+    expect(order.priceIrr, 8500000);
+  });
+}
