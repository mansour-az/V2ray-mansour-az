+  String _moneyToman(int value) {
+    final toman = value ~/ 10;
+    final grouped = toman.toString().replaceAllMapped(
+        RegExp(r'\B(?=(\d{3})+(?!\d))'), (_) => '٬');
+    const latin = '0123456789';
+    const persian = '۰۱۲۳۴۵۶۷۸۹';
+    final localized = grouped.split('').map((char) {
+      final index = latin.indexOf(char);
+      return index < 0 ? char : persian[index];
+    }).join();
+    return '$localized تومان';
+  }
