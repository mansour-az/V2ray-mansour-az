+  /// Selects a payload server even when it is nested inside an URLTest group.
+  /// The outer selector keeps pointing at that URLTest group while its chosen
+  /// child changes, so manual selection and Smart Connect share one path.
+  Future<void> selectVenzoServer(String nodeTag) async {
+    final selectorTag = _state.selectedGroup;
+    if (selectorTag == null || !_state.tunnelUp || _state.busy) return;
+    final selector = _state.groupOf(selectorTag);
+    if (selector == null) return;
+
+    if (selector.items.any((item) => item.tag == nodeTag)) {
+      await switchNode(nodeTag);
+      return;
+    }
+
+    CcGroup? parent;
+    for (final item in selector.items) {
+      final nested = _state.groupOf(item.tag);
+      if (nested != null && nested.items.any((child) => child.tag == nodeTag)) {
+        parent = nested;
+        break;
+      }
+    }
+    if (parent == null) return;
+    final nestedParent = parent;
+
+    _emit(_state.copyWith(busy: true, highlightedNode: nodeTag));
+    try {
+      final childOk = await _cc.selectOutbound(nestedParent.tag, nodeTag);
+      if (!childOk) throw const FormatException('nested select rejected');
+      if (selector.selected != nestedParent.tag) {
+        final parentOk =
+            await _cc.selectOutbound(selectorTag, nestedParent.tag);
+        if (!parentOk) throw const FormatException('selector select rejected');
+      }
+      final fresh = await _cc.getGroups();
+      if (fresh != null) _applyGroups(fresh);
+      _addDebug(DebugSource.app,
+          'Venzo server selected: $selectorTag → ${nestedParent.tag} → $nodeTag');
+    } catch (e) {
+      _emit(_state.copyWith(
+          lastError: PrefixedMsg(ErrPrefix.switchFailed, formatUserError(e))));
+      _addDebug(DebugSource.app, 'Venzo server switch error: $e');
+    } finally {
+      _emit(_state.copyWith(busy: false));
+    }
+  }
