diff --git a/app/test/services/l10n/persian_locale_test.dart b/app/test/services/l10n/persian_locale_test.dart
new file mode 100644
index 0000000..dd837e1
--- /dev/null
+++ b/app/test/services/l10n/persian_locale_test.dart
@@ -0,0 +1,33 @@
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter/widgets.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:lxbox/services/l10n/locale_controller.dart';
+
+void main() {
+  test('Persian is a supported locale', () {
+    expect(LocaleController.supportedTags, contains('fa'));
+    expect(LocaleController.supportedLocales, contains(const Locale('fa')));
+  });
+
+  test('Persian dictionary covers the primary connection journey', () {
+    final raw = File('assets/l10n/fa/ui.json').readAsStringSync();
+    final dict = jsonDecode(raw) as Map<String, dynamic>;
+
+    for (final key in <String>[
+      'Smart Connect',
+      'Disconnect',
+      'The best server is selected automatically',
+      'Your connection is protected',
+      'Connected',
+      'Connecting…',
+      'Disconnected',
+      'Servers',
+      'App Settings',
+    ]) {
+      expect((dict[key] as Map<String, dynamic>)['value'], isNotEmpty,
+          reason: 'missing Persian translation for $key');
+    }
+  });
+}
