+import 'package:flutter_test/flutter_test.dart';
+import 'package:lxbox/controllers/home_controller.dart';
+import 'package:lxbox/vpn/cc_channel.dart';
+
+CcOutbound outbound(String tag) =>
+    CcOutbound(tag: tag, type: 'vless', urlTestDelay: 0, urlTestTime: 0);
+
+CcGroup group({
+  required String tag,
+  required String type,
+  required bool selectable,
+  String selected = '',
+  List<CcOutbound> items = const [],
+}) =>
+    CcGroup(
+      tag: tag,
+      type: type,
+      selectable: selectable,
+      selected: selected,
+      isExpand: false,
+      items: items,
+    );
+
+void main() {
+  test('Smart Connect prefers the channel auto URLTest group', () {
+    final selector = group(
+      tag: 'vpn-1',
+      type: 'Selector',
+      selectable: true,
+      items: [outbound('generic-auto'), outbound('vpn-1-auto')],
+    );
+    final generic = group(
+      tag: 'generic-auto',
+      type: 'URLTest',
+      selectable: false,
+    );
+    final preferred = group(
+      tag: 'vpn-1-auto',
+      type: 'URLTest',
+      selectable: false,
+    );
+
+    expect(
+      chooseVenzoSmartAutoGroup(
+        selectorTag: selector.tag,
+        selector: selector,
+        urltestGroups: [generic, preferred],
+      )?.tag,
+      'vpn-1-auto',
+    );
+  });
+
+  test('Smart Connect does not select an unrelated URLTest group', () {
+    final selector = group(
+      tag: 'vpn-1',
+      type: 'Selector',
+      selectable: true,
+      items: [outbound('manual-node')],
+    );
+    final unrelated = group(
+      tag: 'vpn-2-auto',
+      type: 'URLTest',
+      selectable: false,
+    );
+
+    expect(
+      chooseVenzoSmartAutoGroup(
+        selectorTag: selector.tag,
+        selector: selector,
+        urltestGroups: [unrelated],
+      ),
+      isNull,
+    );
+  });
+}
