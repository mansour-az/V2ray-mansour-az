diff --git a/app/lib/services/venzo_managed_subscriptions.dart b/app/lib/services/venzo_managed_subscriptions.dart
new file mode 100644
index 0000000..007b775
--- /dev/null
+++ b/app/lib/services/venzo_managed_subscriptions.dart
@@ -0,0 +1,39 @@
+import '../models/server_list.dart';
+
+/// Curated, independent subscription sources seeded only on a fresh install.
+///
+/// Each source remains a normal editable subscription: users can disable,
+/// remove, replace, or add their own providers. Subscription bodies are cached
+/// by the existing HttpCache layer, so a temporary upstream outage does not
+/// remove the last working nodes from the device.
+class VenzoManagedSubscriptions {
+  VenzoManagedSubscriptions._();
+
+  static const _primaryUrl =
+      'https://cdn.jsdelivr.net/gh/0xRadikal/Free-v2ray-Configs@main/top100.txt';
+  static const _backupUrl =
+      'https://raw.githubusercontent.com/MahanKenway/Freedom-V2Ray/main/configs/vless_sub.txt';
+
+  static List<SubscriptionServers> defaults() => [
+        SubscriptionServers(
+          id: 'venzo-managed-primary-v1',
+          name: 'Venzo Fast Servers',
+          enabled: true,
+          tagPrefix: 'VZ1-',
+          detourPolicy: DetourPolicy.defaults,
+          url: _primaryUrl,
+          updateIntervalHours: 1,
+          onUpdateAction: SubscriptionOnUpdateAction.rebuild,
+        ),
+        SubscriptionServers(
+          id: 'venzo-managed-backup-v1',
+          name: 'Venzo Backup Servers',
+          enabled: true,
+          tagPrefix: 'VZ2-',
+          detourPolicy: DetourPolicy.defaults,
+          url: _backupUrl,
+          updateIntervalHours: 2,
+          onUpdateAction: SubscriptionOnUpdateAction.rebuild,
+        ),
+      ];
+}
diff --git a/app/test/services/venzo_managed_subscriptions_test.dart b/app/test/services/venzo_managed_subscriptions_test.dart
new file mode 100644
index 0000000..080571a
--- /dev/null
+++ b/app/test/services/venzo_managed_subscriptions_test.dart
@@ -0,0 +1,15 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:lxbox/services/venzo_managed_subscriptions.dart';
+
+void main() {
+  test('managed subscriptions are independent, enabled and bounded', () {
+    final subscriptions = VenzoManagedSubscriptions.defaults();
+
+    expect(subscriptions, hasLength(2));
+    expect(subscriptions.every((s) => s.enabled), isTrue);
+    expect(subscriptions.map((s) => Uri.parse(s.url).host).toSet(), hasLength(2));
+    expect(subscriptions.every((s) => s.updateIntervalHours >= 1), isTrue);
+    expect(subscriptions.map((s) => s.id).toSet(), hasLength(2));
+    expect(subscriptions.map((s) => s.tagPrefix).toSet(), hasLength(2));
+  });
+}
