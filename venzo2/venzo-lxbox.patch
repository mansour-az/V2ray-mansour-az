diff --git a/app/lib/services/venzo_premium.dart b/app/lib/services/venzo_premium.dart
new file mode 100644
index 0000000..dc39357
--- /dev/null
+++ b/app/lib/services/venzo_premium.dart
@@ -0,0 +1,68 @@
+import '../models/server_list.dart';
+
+/// Access tiers are deliberately separate from subscription transport. The
+/// backend can later issue a per-user HTTPS subscription after Telegram/payment
+/// verification without changing the VPN engine or the free catalog.
+enum VenzoAccessTier { free, premium }
+
+class VenzoPremiumEntitlement {
+  const VenzoPremiumEntitlement({
+    required this.accountId,
+    required this.subscriptionUrl,
+    required this.expiresAt,
+  });
+
+  final String accountId;
+  final Uri subscriptionUrl;
+  final DateTime expiresAt;
+
+  bool get isActive =>
+      subscriptionUrl.scheme == 'https' &&
+      subscriptionUrl.host.isNotEmpty &&
+      expiresAt.isAfter(DateTime.now().toUtc());
+}
+
+class VenzoPremiumProvisioner {
+  VenzoPremiumProvisioner._();
+
+  /// Compile-time hook for the future entitlement API. It is intentionally
+  /// empty in public builds; secrets and customer tokens never enter git.
+  static const apiBase = String.fromEnvironment(
+    'VENZO_PREMIUM_API_BASE',
+    defaultValue: '',
+  );
+
+  static bool get backendConfigured {
+    final uri = Uri.tryParse(apiBase);
+    return uri != null && uri.scheme == 'https' && uri.host.isNotEmpty;
+  }
+
+  /// Converts a verified backend entitlement into the same subscription model
+  /// already used by the free tier. Rebuild, cache, failover and Smart Connect
+  /// therefore work identically for paid servers.
+  static SubscriptionServers subscriptionFor(
+    VenzoPremiumEntitlement entitlement,
+  ) {
+    if (!entitlement.isActive) {
+      throw ArgumentError.value(entitlement, 'entitlement', 'inactive');
+    }
+    final safeAccount = entitlement.accountId
+        .replaceAll(RegExp(r'[^a-zA-Z0-9_-]'), '')
+        .take(24);
+    return SubscriptionServers(
+      id: 'venzo-premium-$safeAccount',
+      name: 'Venzo Premium',
+      enabled: true,
+      tagPrefix: 'VZP-',
+      detourPolicy: DetourPolicy.defaults,
+      url: entitlement.subscriptionUrl.toString(),
+      updateIntervalHours: 1,
+      onUpdateAction: SubscriptionOnUpdateAction.reload,
+    );
+  }
+}
+
+extension on String {
+  String take(int maxLength) =>
+      length <= maxLength ? this : substring(0, maxLength);
+}
