@@ -0,0 +1,179 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+
+import '../../../controllers/home_controller.dart';
+import '../../../models/home_state.dart';
+import '../../../services/venzo_server_info.dart';
+
+class VenzoConnectionPanel extends StatelessWidget {
+  const VenzoConnectionPanel({
+    super.key,
+    required this.controller,
+    required this.state,
+  });
+
+  final HomeController controller;
+  final HomeState state;
+
+  @override
+  Widget build(BuildContext context) {
+    if (!state.tunnelUp) return const SizedBox.shrink();
+    final active = VenzoServerInfo.active(state);
+    final servers = VenzoServerInfo.available(state);
+    final cs = Theme.of(context).colorScheme;
+
+    return Padding(
+      padding: const EdgeInsets.only(top: 12),
+      child: Card(
+        margin: EdgeInsets.zero,
+        child: Column(
+          children: [
+            ListTile(
+              leading: Text(active?.flag ?? '🌐',
+                  style: const TextStyle(fontSize: 30)),
+              title: Text(active?.location ?? 'در حال بررسی سرور…',
+                  style: const TextStyle(fontWeight: FontWeight.w700)),
+              subtitle: Text(active == null
+                  ? 'بهترین کانفیگ به‌صورت خودکار انتخاب می‌شود'
+                  : '${active.protocol}  •  ${active.pingMs > 0 ? '${active.pingMs} ms' : 'در حال اندازه‌گیری'}'),
+              trailing: Icon(Icons.verified_user_rounded, color: cs.primary),
+            ),
+            const Divider(height: 1),
+            ListTile(
+              leading: const Icon(Icons.dns_rounded),
+              title: const Text('سرورهای در دسترس'),
+              subtitle: Text(servers.isEmpty
+                  ? 'برای یافتن سرور سالم، تست پینگ را اجرا کنید'
+                  : '${servers.length} سرور سالم پیدا شد'),
+              trailing: const Icon(Icons.chevron_left),
+              onTap: () => _showServers(context),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+
+  Future<void> _showServers(BuildContext context) async {
+    await showModalBottomSheet<void>(
+      context: context,
+      isScrollControlled: true,
+      showDragHandle: true,
+      builder: (sheetContext) => AnimatedBuilder(
+        animation: controller,
+        builder: (context, _) {
+          final current = controller.state;
+          final servers = VenzoServerInfo.available(current);
+          return SafeArea(
+            child: SizedBox(
+              height: MediaQuery.sizeOf(context).height * .68,
+              child: Column(
+                children: [
+                  Padding(
+                    padding: const EdgeInsets.fromLTRB(20, 0, 20, 12),
+                    child: Row(
+                      children: [
+                        const Expanded(
+                          child: Text('انتخاب سرور سالم',
+                              style: TextStyle(
+                                  fontSize: 19, fontWeight: FontWeight.w800)),
+                        ),
+                        IconButton.filledTonal(
+                          tooltip: 'تست دوباره',
+                          onPressed: current.busy || controller.massPingRunning
+                              ? null
+                              : () => unawaited(controller.runMassUrltest()),
+                          icon: controller.massPingRunning
+                              ? const SizedBox.square(
+                                  dimension: 18,
+                                  child: CircularProgressIndicator(strokeWidth: 2))
+                              : const Icon(Icons.refresh),
+                        ),
+                      ],
+                    ),
+                  ),
+                  if (servers.isEmpty)
+                    Expanded(
+                      child: Center(
+                        child: Padding(
+                          padding: const EdgeInsets.all(28),
+                          child: Column(
+                            mainAxisSize: MainAxisSize.min,
+                            children: [
+                              const Icon(Icons.radar_rounded, size: 48),
+                              const SizedBox(height: 12),
+                              const Text('هنوز سرور سالمی اندازه‌گیری نشده است',
+                                  textAlign: TextAlign.center),
+                              const SizedBox(height: 12),
+                              FilledButton.icon(
+                                onPressed: controller.massPingRunning
+                                    ? null
+                                    : () => unawaited(
+                                        controller.runMassUrltest()),
+                                icon: const Icon(Icons.speed),
+                                label: const Text('شروع تست پینگ'),
+                              ),
+                            ],
+                          ),
+                        ),
+                      ),
+                    )
+                  else
+                    Expanded(
+                      child: ListView.separated(
+                        padding: const EdgeInsets.fromLTRB(12, 0, 12, 24),
+                        itemCount: servers.length,
+                        separatorBuilder: (_, __) => const Divider(height: 1),
+                        itemBuilder: (context, index) {
+                          final server = servers[index];
+                          return ListTile(
+                            leading: Text(server.flag,
+                                style: const TextStyle(fontSize: 28)),
+                            title: Text(server.location,
+                                style: const TextStyle(
+                                    fontWeight: FontWeight.w700)),
+                            subtitle: Text(server.protocol),
+                            trailing: Row(
+                              mainAxisSize: MainAxisSize.min,
+                              children: [
+                                Text('${server.pingMs} ms',
+                                    textDirection: TextDirection.ltr,
+                                    style: TextStyle(
+                                      color: server.pingMs < 250
+                                          ? Colors.green
+                                          : server.pingMs < 600
+                                              ? Colors.orange
+                                              : Colors.red,
+                                      fontWeight: FontWeight.w700,
+                                    )),
+                                const SizedBox(width: 8),
+                                Icon(server.selected
+                                    ? Icons.check_circle
+                                    : Icons.radio_button_unchecked),
+                              ],
+                            ),
+                            selected: server.selected,
+                            enabled: !current.busy,
+                            onTap: server.selected
+                                ? null
+                                : () async {
+                                    await controller
+                                        .selectVenzoServer(server.tag);
+                                    if (sheetContext.mounted) {
+                                      Navigator.of(sheetContext).pop();
+                                    }
+                                  },
+                          );
+                        },
+                      ),
+                    ),
+                ],
+              ),
+            ),
+          );
+        },
+      ),
+    );
+  }
+}
