new file mode 100644
index 0000000..3459fa8
--- /dev/null
+++ b/app/lib/screens/venzo_store_screen.dart
@@ -0,0 +1,168 @@
+import 'package:flutter/material.dart';
+
+import '../services/project_links.dart';
+import '../services/url_launcher.dart' as ul;
+import '../services/venzo_store_api.dart';
+
+class VenzoStoreScreen extends StatefulWidget {
+  const VenzoStoreScreen({super.key});
+
+  @override
+  State<VenzoStoreScreen> createState() => _VenzoStoreScreenState();
+}
+
+class _VenzoStoreScreenState extends State<VenzoStoreScreen> {
+  final _api = VenzoStoreApi();
+  final _customer = TextEditingController();
+  late Future<List<VenzoPlan>> _plans;
+  String? _buying;
+
+  @override
+  void initState() {
+    super.initState();
+    _plans = _api.plans();
+  }
+
+  @override
+  void dispose() {
+    _customer.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Scaffold(
+      appBar: AppBar(title: const Text('خرید اشتراک Venzo')),
+      body: FutureBuilder<List<VenzoPlan>>(
+        future: _plans,
+        builder: (context, snapshot) {
+          if (snapshot.connectionState == ConnectionState.waiting) {
+            return const Center(child: CircularProgressIndicator());
+          }
+          if (snapshot.hasError) return _unavailable(context);
+          final plans = snapshot.data ?? const [];
+          if (plans.isEmpty) return _unavailable(context);
+          return ListView(
+            padding: const EdgeInsets.all(16),
+            children: [
+              Card(
+                color: Theme.of(context).colorScheme.primaryContainer,
+                child: const Padding(
+                  padding: EdgeInsets.all(16),
+                  child: Row(
+                    children: [
+                      Icon(Icons.workspace_premium_rounded, size: 34),
+                      SizedBox(width: 12),
+                      Expanded(
+                        child: Text(
+                          'پس از پرداخت، اشتراک اختصاصی به‌صورت خودکار در پنل PasarGuard ساخته می‌شود.',
+                          style: TextStyle(fontWeight: FontWeight.w600),
+                        ),
+                      ),
+                    ],
+                  ),
+                ),
+              ),
+              const SizedBox(height: 12),
+              TextField(
+                controller: _customer,
+                textDirection: TextDirection.ltr,
+                decoration: const InputDecoration(
+                  labelText: 'شماره موبایل یا شناسه تلگرام',
+                  prefixIcon: Icon(Icons.person_outline),
+                  border: OutlineInputBorder(),
+                ),
+              ),
+              const SizedBox(height: 16),
+              for (final plan in plans) ...[
+                _planCard(context, plan),
+                const SizedBox(height: 10),
+              ],
+            ],
+          );
+        },
+      ),
+    );
+  }
+
+  Widget _planCard(BuildContext context, VenzoPlan plan) {
+    final busy = _buying == plan.id;
+    return Card(
+      child: Padding(
+        padding: const EdgeInsets.all(16),
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.stretch,
+          children: [
+            Text(plan.title,
+                style: Theme.of(context)
+                    .textTheme
+                    .titleMedium
+                    ?.copyWith(fontWeight: FontWeight.w800)),
+            const SizedBox(height: 8),
+            Text('${plan.days} روز  •  ${plan.dataGb == null ? 'نامحدود' : '${plan.dataGb} گیگابایت'}'),
+            const SizedBox(height: 12),
+            FilledButton(
+              onPressed: _buying == null ? () => _buy(plan) : null,
+              child: busy
+                  ? const SizedBox.square(
+                      dimension: 20,
+                      child: CircularProgressIndicator(strokeWidth: 2))
+                  : Text('خرید — ${_price(plan)}'),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+
+  String _price(VenzoPlan plan) {
+    final value = plan.price.toString().replaceAllMapped(
+        RegExp(r'\B(?=(\d{3})+(?!\d))'), (_) => '٬');
+    return '$value ${plan.currency == 'IRR' ? 'ریال' : plan.currency}';
+  }
+
+  Future<void> _buy(VenzoPlan plan) async {
+    if (_customer.text.trim().length < 3) {
+      ScaffoldMessenger.of(context).showSnackBar(const SnackBar(
+          content: Text('شماره موبایل یا شناسه تلگرام را وارد کنید')));
+      return;
+    }
+    setState(() => _buying = plan.id);
+    try {
+      final checkout = await _api.createCheckout(
+          planId: plan.id, customer: _customer.text);
+      await ul.UrlLauncher.open(checkout.url);
+    } catch (_) {
+      if (mounted) {
+        ScaffoldMessenger.of(context).showSnackBar(const SnackBar(
+            content: Text('ساخت لینک پرداخت انجام نشد؛ دوباره تلاش کنید')));
+      }
+    } finally {
+      if (mounted) setState(() => _buying = null);
+    }
+  }
+
+  Widget _unavailable(BuildContext context) => Center(
+        child: Padding(
+          padding: const EdgeInsets.all(28),
+          child: Column(
+            mainAxisSize: MainAxisSize.min,
+            children: [
+              const Icon(Icons.storefront_outlined, size: 58),
+              const SizedBox(height: 14),
+              const Text('فروش آنلاین در حال راه‌اندازی است',
+                  style: TextStyle(fontSize: 19, fontWeight: FontWeight.w800)),
+              const SizedBox(height: 8),
+              const Text('برای خرید فعلی با پشتیبانی Venzo تماس بگیرید.',
+                  textAlign: TextAlign.center),
+              const SizedBox(height: 16),
+              FilledButton.icon(
+                onPressed: () => ul.UrlLauncher.open(ProjectLinks.support),
+                icon: const Icon(Icons.support_agent),
+                label: const Text('@Venzzo_vpn'),
+              ),
+            ],
+          ),
+        ),
+      );
+}
