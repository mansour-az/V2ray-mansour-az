+/// Pure selection rule shared by runtime and tests: prefer the channel's
+/// canonical `<selector>-auto` group, otherwise use a URLTest group that is a
+/// member of the active selector.
+CcGroup? chooseVenzoSmartAutoGroup({
+  required String selectorTag,
+  required CcGroup? selector,
+  required Iterable<CcGroup> urltestGroups,
+}) {
+  final preferredTag = '$selectorTag-auto';
+  CcGroup? fallback;
+  for (final group in urltestGroups) {
+    if (group.tag == preferredTag) return group;
+    final isSelectorMember =
+        selector?.items.any((item) => item.tag == group.tag) ?? false;
+    if (isSelectorMember) fallback ??= group;
+  }
+  return fallback;
