+import '../models/server_list.dart';
+
+/// Curated, independent subscription sources seeded only on a fresh install.
+///
+/// Each source remains a normal editable subscription: users can disable,
+/// remove, replace, or add their own providers. Subscription bodies are cached
+/// by the existing HttpCache layer, so a temporary upstream outage does not
+/// remove the last working nodes from the device.
+class VenzoManagedSubscriptions {
+  VenzoManagedSubscriptions._();
+
+  static const _primaryUrl =
+      'https://cdn.jsdelivr.net/gh/0xRadikal/Free-v2ray-Configs@main/top100.txt';
+  static const _backupUrl =
+      'https://raw.githubusercontent.com/MahanKenway/Freedom-V2Ray/main/configs/vless_sub.txt';
+
+  static List<SubscriptionServers> defaults() => [
+        SubscriptionServers(
+          id: 'venzo-managed-primary-v1',
+          name: 'Venzo Fast Servers',
+          enabled: true,
+          tagPrefix: 'VZ1-',
+          detourPolicy: DetourPolicy.defaults,
+          url: _primaryUrl,
+          updateIntervalHours: 1,
+          onUpdateAction: SubscriptionOnUpdateAction.rebuild,
+        ),
+        SubscriptionServers(
+          id: 'venzo-managed-backup-v1',
+          name: 'Venzo Backup Servers',
+          enabled: true,
+          tagPrefix: 'VZ2-',
+          detourPolicy: DetourPolicy.defaults,
+          url: _backupUrl,
+          updateIntervalHours: 2,
+          onUpdateAction: SubscriptionOnUpdateAction.rebuild,
+        ),
+      ];
+}
diff --git a/app/lib/services/venzo_premium.dart b/app/lib/services/venzo_premium.dart
new file mode 100644
index 0000000..dc39357
--- /dev/null
+++ b/app/lib/services/venzo_premium.dart
@@ -0,0 +1,68 @@
+import '../models/server_list.dart';
+
+/// Access tiers are deliberately separate from subscription transport. The
+/// backend can later issue a per-user HTTPS subscription after Telegram/payment
+/// verification without changing the VPN engine or the free catalog.
+enum VenzoAccessTier { free, premium }
+
+class VenzoPremiumEntitlement {
+  const VenzoPremiumEntitlement({
+    required this.accountId,
+    required this.subscriptionUrl,
+    required this.expiresAt,
+  });
+
+  final String accountId;
+  final Uri subscriptionUrl;
+  final DateTime expiresAt;
+
+  bool get isActive =>
+      subscriptionUrl.scheme == 'https' &&
+      subscriptionUrl.host.isNotEmpty &&
+      expiresAt.isAfter(DateTime.now().toUtc());
+}
+
+class VenzoPremiumProvisioner {
+  VenzoPremiumProvisioner._();
+
+  /// Compile-time hook for the future entitlement API. It is intentionally
+  /// empty in public builds; secrets and customer tokens never enter git.
+  static const apiBase = String.fromEnvironment(
+    'VENZO_PREMIUM_API_BASE',
+    defaultValue: '',
+  );
+
+  static bool get backendConfigured {
+    final uri = Uri.tryParse(apiBase);
+    return uri != null && uri.scheme == 'https' && uri.host.isNotEmpty;
+  }
+
+  /// Converts a verified backend entitlement into the same subscription model
+  /// already used by the free tier. Rebuild, cache, failover and Smart Connect
+  /// therefore work identically for paid servers.
+  static SubscriptionServers subscriptionFor(
+    VenzoPremiumEntitlement entitlement,
+  ) {
+    if (!entitlement.isActive) {
+      throw ArgumentError.value(entitlement, 'entitlement', 'inactive');
+    }
+    final safeAccount = entitlement.accountId
+        .replaceAll(RegExp(r'[^a-zA-Z0-9_-]'), '')
+        .take(24);
+    return SubscriptionServers(
+      id: 'venzo-premium-$safeAccount',
+      name: 'Venzo Premium',
+      enabled: true,
+      tagPrefix: 'VZP-',
+      detourPolicy: DetourPolicy.defaults,
+      url: entitlement.subscriptionUrl.toString(),
+      updateIntervalHours: 1,
+      onUpdateAction: SubscriptionOnUpdateAction.reload,
+    );
+  }
+}
+
+extension on String {
+  String take(int maxLength) =>
+      length <= maxLength ? this : substring(0, maxLength);
+}
diff --git a/app/lib/services/venzo_server_info.dart b/app/lib/services/venzo_server_info.dart
new file mode 100644
index 0000000..5b43c06
--- /dev/null
+++ b/app/lib/services/venzo_server_info.dart
@@ -0,0 +1,136 @@
+import '../models/home_state.dart';
+import '../vpn/cc_channel.dart';
+
+/// A user-facing view of a payload server. Control outbounds and failed
+/// probes are intentionally excluded from [available].
+class VenzoServerInfo {
+  const VenzoServerInfo({
+    required this.tag,
+    required this.location,
+    required this.flag,
+    required this.protocol,
+    required this.pingMs,
+    required this.selected,
+  });
+
+  final String tag;
+  final String location;
+  final String flag;
+  final String protocol;
+  final int pingMs;
+  final bool selected;
+
+  static String? activePayloadTag(HomeState state) {
+    var tag = state.activeInGroup;
+    final seen = <String>{};
+    while (tag != null && tag.isNotEmpty && seen.add(tag)) {
+      final group = state.groupOf(tag);
+      if (group == null || group.selected.isEmpty) return tag;
+      tag = group.selected;
+    }
+    return tag;
+  }
+
+  static List<VenzoServerInfo> available(HomeState state) {
+    final selector = state.selectedGroup == null
+        ? null
+        : state.groupOf(state.selectedGroup!);
+    if (selector == null) return const [];
+
+    final candidates = <String, CcOutbound>{};
+    for (final item in selector.items) {
+      final nested = state.groupOf(item.tag);
+      if (nested == null) {
+        candidates[item.tag] = item;
+      } else {
+        for (final child in nested.items) {
+          candidates[child.tag] = child;
+        }
+      }
+    }
+
+    final active = activePayloadTag(state);
+    final result = <VenzoServerInfo>[];
+    for (final outbound in candidates.values) {
+      if (state.isControlTag(outbound.tag)) continue;
+      final measured = state.delayOf(outbound.tag);
+      final coreDelay = outbound.urlTestTime > 0 ? outbound.urlTestDelay : null;
+      final delay = measured != null && measured >= 0 ? measured : coreDelay;
+      if (delay == null || delay <= 0) continue;
+      final place = _locationOf(outbound.tag);
+      result.add(VenzoServerInfo(
+        tag: outbound.tag,
+        location: place.$2,
+        flag: place.$1,
+        protocol: state.activeModel.protocolOf(outbound.tag) ??
+            (outbound.type.isEmpty ? 'Proxy' : outbound.type.toUpperCase()),
+        pingMs: delay,
+        selected: outbound.tag == active,
+      ));
+    }
+    result.sort((a, b) => a.pingMs.compareTo(b.pingMs));
+    return result;
+  }
+
+  static VenzoServerInfo? active(HomeState state) {
+    final activeTag = activePayloadTag(state);
+    if (activeTag == null) return null;
+    for (final server in available(state)) {
+      if (server.tag == activeTag) return server;
+    }
+    final place = _locationOf(activeTag);
+    return VenzoServerInfo(
+      tag: activeTag,
+      location: place.$2,
+      flag: place.$1,
+      protocol: state.activeModel.protocolOf(activeTag) ?? 'Proxy',
+      pingMs: state.delayOf(activeTag) ?? 0,
+      selected: true,
+    );
+  }
+
+  static (String, String) _locationOf(String tag) {
+    final flag = _firstFlag(tag);
+    final country = flag == null ? null : _countryByFlag[flag];
+    if (country != null) return (flag!, country);
+
+    final lower = tag.toLowerCase();
+    for (final entry in _countryHints.entries) {
+      if (entry.value.any(lower.contains)) return entry.key;
+    }
+    return ('🌐', 'نامشخص');
+  }
+
+  static String? _firstFlag(String value) {
+    final runes = value.runes.toList();
+    for (var i = 0; i + 1 < runes.length; i++) {
+      if (_isRegional(runes[i]) && _isRegional(runes[i + 1])) {
+        return String.fromCharCodes([runes[i], runes[i + 1]]);
+      }
+    }
+    return null;
+  }
+
+  static bool _isRegional(int rune) => rune >= 0x1F1E6 && rune <= 0x1F1FF;
+
+  static const _countryByFlag = <String, String>{
+    '🇩🇪': 'آلمان', '🇺🇸': 'آمریکا', '🇳🇱': 'هلند', '🇫🇮': 'فنلاند',
+    '🇫🇷': 'فرانسه', '🇬🇧': 'بریتانیا', '🇨🇦': 'کانادا', '🇹🇷': 'ترکیه',
+    '🇸🇬': 'سنگاپور', '🇯🇵': 'ژاپن', '🇨🇭': 'سوئیس', '🇸🇪': 'سوئد',
+    '🇦🇪': 'امارات', '🇮🇹': 'ایتالیا', '🇪🇸': 'اسپانیا', '🇵🇱': 'لهستان',
+    '🇷🇺': 'روسیه', '🇮🇳': 'هند', '🇭🇰': 'هنگ‌کنگ', '🇦🇺': 'استرالیا',
+  };
+
+  static const _countryHints = <(String, String), List<String>>{
+    ('🇩🇪', 'آلمان'): ['germany', 'de-', ' de '],
+    ('🇺🇸', 'آمریکا'): ['united states', 'usa', 'us-', ' us '],
+    ('🇳🇱', 'هلند'): ['netherlands', 'holland', 'nl-'],
+    ('🇫🇮', 'فنلاند'): ['finland', 'fi-'],
+    ('🇫🇷', 'فرانسه'): ['france', 'fr-'],
+    ('🇬🇧', 'بریتانیا'): ['united kingdom', 'england', 'uk-', 'gb-'],
+    ('🇨🇦', 'کانادا'): ['canada', 'ca-'],
+    ('🇹🇷', 'ترکیه'): ['turkey', 'turkiye', 'tr-'],
+    ('🇸🇬', 'سنگاپور'): ['singapore', 'sg-'],
+    ('🇯🇵', 'ژاپن'): ['japan', 'jp-'],
+  };
+}
diff --git a/app/lib/services/venzo_store_api.dart b/app/lib/services/venzo_store_api.dart
new file mode 100644
index 0000000..2191b33
--- /dev/null
+++ b/app/lib/services/venzo_store_api.dart
@@ -0,0 +1,114 @@
+import 'dart:convert';
+
+import 'package:http/http.dart' as http;
+
+/// Public Venzo commerce API. PasarGuard admin credentials must only exist on
+/// this backend; they are deliberately never accepted by the Android app.
+class VenzoStoreApi {
+  VenzoStoreApi({http.Client? client}) : _client = client ?? http.Client();
+
+  static const baseUrl = String.fromEnvironment('VENZO_API_BASE');
+  final http.Client _client;
+
+  bool get isConfigured {
+    final uri = Uri.tryParse(baseUrl);
+    if (uri == null || !uri.hasScheme || uri.host.isEmpty) return false;
+    return uri.scheme == 'https' ||
+        (uri.scheme == 'http' && uri.host.startsWith('10.'));
+  }
+
+  Future<List<VenzoPlan>> plans() async {
+    if (!isConfigured) throw const VenzoStoreException('API_NOT_CONFIGURED');
+    final response = await _client
+        .get(_uri('/v1/plans'), headers: const {'Accept': 'application/json'})
+        .timeout(const Duration(seconds: 15));
+    if (response.statusCode != 200) {
+      throw VenzoStoreException('PLANS_${response.statusCode}');
+    }
+    final decoded = jsonDecode(utf8.decode(response.bodyBytes));
+    final rows = decoded is List ? decoded : (decoded as Map)['plans'];
+    if (rows is! List) throw const VenzoStoreException('INVALID_PLANS');
+    return rows
+        .whereType<Map>()
+        .map((row) => VenzoPlan.fromJson(row.cast<String, dynamic>()))
+        .where((plan) => plan.id.isNotEmpty && plan.price > 0)
+        .toList();
+  }
+
+  Future<VenzoCheckout> createCheckout({
+    required String planId,
+    required String customer,
+  }) async {
+    if (!isConfigured) throw const VenzoStoreException('API_NOT_CONFIGURED');
+    final response = await _client
+        .post(
+          _uri('/v1/orders'),
+          headers: const {
+            'Accept': 'application/json',
+            'Content-Type': 'application/json',
+          },
+          body: jsonEncode({
+            'plan_id': planId,
+            'customer': customer.trim(),
+            'client': 'venzo-android',
+          }),
+        )
+        .timeout(const Duration(seconds: 20));
+    if (response.statusCode != 200 && response.statusCode != 201) {
+      throw VenzoStoreException('CHECKOUT_${response.statusCode}');
+    }
+    final json = (jsonDecode(utf8.decode(response.bodyBytes)) as Map)
+        .cast<String, dynamic>();
+    final checkout = VenzoCheckout.fromJson(json);
+    if (!checkout.url.startsWith('https://')) {
+      throw const VenzoStoreException('INVALID_CHECKOUT_URL');
+    }
+    return checkout;
+  }
+
+  Uri _uri(String path) => Uri.parse(baseUrl).resolve(path);
+}
+
+class VenzoPlan {
+  const VenzoPlan({
+    required this.id,
+    required this.title,
+    required this.price,
+    required this.currency,
+    required this.days,
+    required this.dataGb,
+  });
+
+  final String id;
+  final String title;
+  final int price;
+  final String currency;
+  final int days;
+  final int? dataGb;
+
+  factory VenzoPlan.fromJson(Map<String, dynamic> json) => VenzoPlan(
+        id: json['id']?.toString() ?? '',
+        title: json['title']?.toString() ?? '',
+        price: (json['price'] as num?)?.toInt() ?? 0,
+        currency: json['currency']?.toString() ?? 'IRR',
+        days: (json['days'] as num?)?.toInt() ?? 30,
+        dataGb: (json['data_gb'] as num?)?.toInt(),
+      );
+}
+
+class VenzoCheckout {
+  const VenzoCheckout({required this.orderId, required this.url});
+
+  final String orderId;
+  final String url;
+
+  factory VenzoCheckout.fromJson(Map<String, dynamic> json) => VenzoCheckout(
+        orderId: json['order_id']?.toString() ?? '',
+        url: json['checkout_url']?.toString() ?? '',
+      );
+}
+
+class VenzoStoreException implements Exception {
+  const VenzoStoreException(this.code);
+  final String code;
+}
