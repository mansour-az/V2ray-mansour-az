@@ -0,0 +1,33 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:lxbox/models/server_list.dart';
+import 'package:lxbox/services/venzo_premium.dart';
+
+void main() {
+  test('premium entitlement provisions an isolated subscription', () {
+    final entitlement = VenzoPremiumEntitlement(
+      accountId: 'user-42',
+      subscriptionUrl: Uri.parse('https://premium.venzo.example/sub/user-42'),
+      expiresAt: DateTime.now().toUtc().add(const Duration(days: 30)),
+    );
+
+    final subscription = VenzoPremiumProvisioner.subscriptionFor(entitlement);
+    expect(subscription.name, 'Venzo Premium');
+    expect(subscription.tagPrefix, 'VZP-');
+    expect(subscription.enabled, isTrue);
+    expect(subscription.onUpdateAction, SubscriptionOnUpdateAction.reload);
+    expect(Uri.parse(subscription.url).scheme, 'https');
+  });
+
+  test('expired or insecure premium entitlement is rejected', () {
+    final expired = VenzoPremiumEntitlement(
+      accountId: 'user-42',
+      subscriptionUrl: Uri.parse('http://premium.venzo.example/sub'),
+      expiresAt: DateTime.now().toUtc().subtract(const Duration(minutes: 1)),
+    );
+
+    expect(
+      () => VenzoPremiumProvisioner.subscriptionFor(expired),
+      throwsArgumentError,
+    );
+  });
+}
