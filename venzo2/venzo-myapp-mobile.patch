diff --git a/app/lib/services/venzo_update_installer.dart b/app/lib/services/venzo_update_installer.dart
new file mode 100644
index 0000000..5d2634f
--- /dev/null
+++ b/app/lib/services/venzo_update_installer.dart
@@ -0,0 +1,81 @@
+import 'dart:io';
+
+import 'package:crypto/crypto.dart';
+import 'package:flutter/services.dart';
+import 'package:http/http.dart' as http;
+import 'package:path_provider/path_provider.dart';
+
+import 'platform_channels.dart';
+import 'update_checker.dart';
+
+class VenzoUpdateInstaller {
+  VenzoUpdateInstaller._();
+
+  static const _channel = MethodChannel(PlatformChannels.utils);
+  static const _maxBytes = 250 * 1024 * 1024;
+
+  static Future<void> downloadAndInstall(
+    UpdateInfo info, {
+    required void Function(double value) onProgress,
+  }) async {
+    final url = info.apkUrl ?? _releaseApkUrl(info.tag);
+    final uri = Uri.parse(url);
+    if (uri.scheme != 'https' || uri.host != 'github.com') {
+      throw const FormatException('نشانی بروزرسانی معتبر نیست');
+    }
+
+    final request = http.Request('GET', uri)
+      ..headers['User-Agent'] = 'VenzoVPN/Android';
+    final response = await request.send().timeout(const Duration(seconds: 25));
+    if (response.statusCode != 200) {
+      throw HttpException('خطای دانلود: HTTP ${response.statusCode}');
+    }
+    final advertised = response.contentLength ?? 0;
+    if (advertised > _maxBytes) {
+      throw const FileSystemException('فایل بروزرسانی بیش از حد بزرگ است');
+    }
+
+    final directory = await getTemporaryDirectory();
+    final version = info.tag.replaceFirst(RegExp(r'^[vV]'), '');
+    final file = File('${directory.path}/Venzo-VPN-$version-arm64.apk');
+    final sink = file.openWrite();
+    var received = 0;
+    try {
+      await for (final chunk in response.stream) {
+        received += chunk.length;
+        if (received > _maxBytes) {
+          throw const FileSystemException('فایل بروزرسانی بیش از حد بزرگ است');
+        }
+        sink.add(chunk);
+        if (advertised > 0) onProgress(received / advertised);
+      }
+    } finally {
+      await sink.close();
+    }
+
+    final actual =
+        sha256.convert(await file.readAsBytes()).toString().toLowerCase();
+    final expected = info.apkSha256?.trim().toLowerCase();
+    if (expected != null && expected.isNotEmpty && actual != expected) {
+      await file.delete();
+      throw const FormatException('اعتبار فایل بروزرسانی تأیید نشد');
+    }
+    onProgress(1);
+    final opened = await _channel.invokeMethod<bool>(
+          'installApk',
+          {'path': file.path},
+        ) ??
+        false;
+    if (!opened) {
+      throw const FileSystemException(
+        'اجازه نصب برنامه داده نشده؛ مجوز نصب از این منبع را فعال و دوباره تلاش کنید',
+      );
+    }
+  }
+
+  static String _releaseApkUrl(String tag) {
+    final version = tag.replaceFirst(RegExp(r'^[vV]'), '');
+    return 'https://github.com/mansour-az/V2ray-mansour-az/'
+        'releases/download/$tag/Venzo-VPN-$version-arm64.apk';
+  }
+}
