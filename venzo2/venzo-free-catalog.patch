     }
+    final catalogSeeded =
+        await SettingsStorage.getVar('venzo_live_catalog_seeded_v2', 'false') ==
+            'true';
+    if (!catalogSeeded) {
+      final catalog = VenzoManagedSubscriptions.defaults().first;
+      final exists = lists.whereType<SubscriptionServers>().any(
+          (list) => list.id == catalog.id || list.url == catalog.url);
+      if (!exists) {
+        lists = [catalog, ...lists];
+        await SettingsStorage.saveServerLists(lists);
+        AppLog.I.info('Installed Venzo live free catalog');
+      }
+      await SettingsStorage.setVar('venzo_live_catalog_seeded_v2', 'true');
+    }
     _entries = lists.map((l) => SubscriptionEntry(list: l)).toList();
