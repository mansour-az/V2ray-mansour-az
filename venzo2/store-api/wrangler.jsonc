{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "venzo-store-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-21",
  "observability": {
    "enabled": true
  },
  "vars": {
    "SUPPORT_URL": "https://t.me/Venzzo_vpn",
    "PASARGUARD_GROUP_IDS": "",
    "USDT_TRC20_CONTRACT": ""
  },
  "secrets": {
    "required": [
      "PASARGUARD_BASE_URL",
      "PASARGUARD_API_KEY or PASARGUARD_ADMIN_USERNAME + PASARGUARD_ADMIN_PASSWORD",
      "PROVISION_SECRET",
      "TRON_WALLET_ADDRESS",
      "TRONGRID_API_KEY",
      "USDT_IRR",
      "TRX_IRR",
      "CARD_NUMBER",
      "CARD_HOLDER"
    ]
  }
}
