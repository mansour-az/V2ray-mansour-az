{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "venzo-store-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-21",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "ORDERS"
    }
  ],
  "vars": {
    "SUPPORT_URL": "https://t.me/Venzzo_vpn",
    "PASARGUARD_GROUP_IDS": "",
    "USDT_TRC20_CONTRACT": ""
  }
}
