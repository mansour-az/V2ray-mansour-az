{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "venzo-store-api",
  "main": "src/router.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["17 */4 * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNT_LEDGER",
        "class_name": "AccountLedger"
      },
      {
        "name": "ADMIN_STATE",
        "class_name": "AdminState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-account-ledger",
      "new_sqlite_classes": ["AccountLedger"]
    },
    {
      "tag": "v2-admin-state",
      "new_sqlite_classes": ["AdminState"]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ORDERS"
    }
  ],
  "vars": {
    "SUPPORT_URL": "https://t.me/Venzzo_vpn",
    "PASARGUARD_GROUP_IDS": "",
    "USDT_TRC20_CONTRACT": ""
  }
}
